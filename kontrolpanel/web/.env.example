# Kopiér til web/.env.local og udfyld fra Firebase-konsollen
# (Projektindstillinger → Dine apps → Web-app → SDK setup and configuration).
# Filen her indeholder kun offentlige klientnøgler. Serverhemmeligheder
# (Slack signing secret, Claude API-nøgle) hører hjemme i Secret Manager.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Den ene konto der må logge ind. Håndhæves også i firestore.rules.
VITE_TILLADT_EMAIL=

# Sæt til 1 for at køre panelet mod `firebase emulators:start` i stedet for
# det rigtige projekt. Portene står i ../firebase.json.
VITE_BRUG_EMULATOR=
