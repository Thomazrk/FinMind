---
/**
 * Forsidens argument. Ikke ord om sløjfen — sløjfen selv, med de samme trin som
 * kontrolpanelet kører: besked, vurdering, rettelse, godkendelse, live.
 *
 * Første trin er tændt i markuppen, så demoen aldrig står tom, hvis JavaScript
 * er langsomt eller slået fra. Resten trappes op af scriptet.
 */
import { demoCases } from "../data/demo";

const first = demoCases[0];
---

<div class="demo">
  <div class="demo-bar">
    <span id="demo-channel">{first.channel}</span>
    <span id="demo-clock">i dag, {first.time}</span>
  </div>
  <div class="demo-body">
    <div class="msg">
      <div class="msg-avatar" id="demo-initials">{first.initials}</div>
      <div>
        <p class="msg-who">
          <span id="demo-sender">{first.sender}</span>
          <span id="demo-time">{first.time}</span>
        </p>
        <p class="msg-text" id="demo-text">{first.text}</p>
      </div>
    </div>

    <ol class="steps" id="demo-steps">
      {
        first.steps.map((step, i) => (
          <li class:list={["step", step.kind, { on: i === 0 }]}>
            <span class="step-dot" />
            <div>
              <p class="step-what">{step.what}</p>
              <p class="step-detail">{step.detail}</p>
              {step.diff && (
                <div class="diff" style="margin-top:0.4rem">
                  <div class="diff-name">før / efter</div>
                  <div class="diff-line diff-before">{step.diff.before}</div>
                  <div class="diff-line diff-after">{step.diff.after}</div>
                </div>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <div id="demo-verdict">
      <p class:list={["verdict", first.verdict.tone]}>{first.verdict.text}</p>
    </div>
  </div>
</div>

<div class="picker" id="demo-picker" role="group" aria-label="Vælg en besked">
  {
    demoCases.map((c, i) => (
      <button class="chip" type="button" data-index={i} aria-pressed={i === 0 ? "true" : "false"}>
        {c.chip}
      </button>
    ))
  }
</div>

<p class="demo-note">Eksempel med opdigtede kunder. Sådan ser sløjfen ud hos os.</p>

<form class="try" id="demo-try">
  <label for="demo-input">Eller skriv din egen — hvad ville du bede om?</label>
  <div class="try-row">
    <input
      id="demo-input"
      name="besked"
      type="text"
      autocomplete="off"
      placeholder="Fx: vores nye telefonnummer er 40 12 88 90"
    />
    <button type="submit" class="chip chip-send">Se hvad der sker</button>
  </div>
  <p class="try-note">
    Det du skriver, bliver i din browser. Vi får det ikke at se.
  </p>
</form>

<script>
  import { demoCases } from "../data/demo";
  import { classify, formatMinutes, COVERED_LIMIT_MINUTES } from "../data/classifier";

  const picker = document.getElementById("demo-picker");
  const stepsEl = document.getElementById("demo-steps");
  const verdictEl = document.getElementById("demo-verdict");
  if (picker && stepsEl && verdictEl) {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let timers: number[] = [];

    const set = (id: string, text: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = text;
    };

    function show(index: number) {
      timers.forEach(clearTimeout);
      timers = [];

      const c = demoCases[index];
      if (!c) return;

      set("demo-channel", c.channel);
      set("demo-clock", `i dag, ${c.time}`);
      set("demo-sender", c.sender);
      set("demo-initials", c.initials);
      set("demo-time", c.time);
      set("demo-text", c.text);

      picker!.querySelectorAll("button").forEach((b, i) => {
        b.setAttribute("aria-pressed", i === index ? "true" : "false");
      });

      stepsEl!.replaceChildren(
        ...c.steps.map((step) => {
          const li = document.createElement("li");
          li.className = ["step", step.kind ?? ""].join(" ").trim();

          const dot = document.createElement("span");
          dot.className = "step-dot";

          const body = document.createElement("div");
          const what = document.createElement("p");
          what.className = "step-what";
          what.textContent = step.what;
          const detail = document.createElement("p");
          detail.className = "step-detail";
          detail.textContent = step.detail;
          body.append(what, detail);

          if (step.diff) {
            const diff = document.createElement("div");
            diff.className = "diff";
            diff.style.marginTop = "0.4rem";
            const name = document.createElement("div");
            name.className = "diff-name";
            name.textContent = "før / efter";
            const before = document.createElement("div");
            before.className = "diff-line diff-before";
            before.textContent = step.diff.before;
            const after = document.createElement("div");
            after.className = "diff-line diff-after";
            after.textContent = step.diff.after;
            diff.append(name, before, after);
            body.append(diff);
          }

          li.append(dot, body);
          return li;
        }),
      );

      const verdict = document.createElement("p");
      verdict.className = `verdict ${c.verdict.tone}`;
      verdict.textContent = c.verdict.text;
      verdictEl!.replaceChildren(verdict);

      // Første trin står tændt med det samme; resten trappes op.
      stepsEl!.querySelectorAll<HTMLElement>(".step").forEach((li, i) => {
        if (reduce || i === 0) {
          li.classList.add("on");
          return;
        }
        timers.push(window.setTimeout(() => li.classList.add("on"), 420 + i * 620));
      });
    }

    picker.querySelectorAll("button").forEach((b) => {
      b.addEventListener("click", () => show(Number(b.dataset.index)));
    });

    /**
     * Den besøgendes egen besked. Samme sløjfe, men trinnene bygges ud fra
     * skønnet — og siger tydeligt fra, når nøgleord ikke rækker.
     */
    function showOwn(message: string) {
      timers.forEach(clearTimeout);
      timers = [];

      const verdict = classify(message);
      const now = new Date();
      const clock = `${String(now.getHours()).padStart(2, "0")}.${String(now.getMinutes()).padStart(2, "0")}`;

      set("demo-channel", "#din-kanal");
      set("demo-clock", `i dag, ${clock}`);
      set("demo-sender", "Dig");
      set("demo-initials", "DU");
      set("demo-time", clock);
      set("demo-text", message);

      picker!.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", "false"));

      type Row = { what: string; detail: string; kind?: string };
      let rows: Row[];

      if (verdict.unsure) {
        rows = [
          { what: "Læst", detail: `${verdict.label} · ${verdict.touches}`, kind: "wait" },
          { what: "Ingen kode skrevet", detail: "Vi gætter ikke på en pris, vi ikke kan stå inde for" },
          { what: "Svar samme dag", detail: "Du hører fra os inden for en arbejdsdag", kind: "wait" },
        ];
      } else if (verdict.covered) {
        rows = [
          {
            what: "Læst og vurderet",
            detail: `${verdict.label} · anslået ${formatMinutes(verdict.minutes!)} · dækket af abonnementet`,
          },
          { what: "Rettelsen bygget", detail: verdict.touches },
          { what: "Afventer godkendelse", detail: "Et menneske ser forslaget igennem", kind: "wait" },
          { what: "Udgivet", detail: "Live samme dag", kind: "done" },
        ];
      } else {
        rows = [
          {
            what: "Læst og vurderet",
            detail: `${verdict.label} · anslået ${formatMinutes(verdict.minutes!)} · over grænsen på ${COVERED_LIMIT_MINUTES} minutter`,
            kind: "wait",
          },
          { what: "Ingen kode skrevet", detail: verdict.touches },
          { what: "Tilbud sendt", detail: "Pris og tidsplan, før der bliver rørt ved noget", kind: "wait" },
        ];
      }

      stepsEl!.replaceChildren(
        ...rows.map((row) => {
          const li = document.createElement("li");
          li.className = ["step", row.kind ?? ""].join(" ").trim();
          const dot = document.createElement("span");
          dot.className = "step-dot";
          const body = document.createElement("div");
          const what = document.createElement("p");
          what.className = "step-what";
          what.textContent = row.what;
          const detail = document.createElement("p");
          detail.className = "step-detail";
          detail.textContent = row.detail;
          body.append(what, detail);
          li.append(dot, body);
          return li;
        }),
      );

      const p = document.createElement("p");
      p.className = `verdict ${verdict.unsure ? "" : verdict.covered ? "live" : "quote"}`.trim();
      p.textContent = verdict.unsure
        ? "Den her kan nøgleord ikke afgøre — og så gætter vi ikke. Skriv til os, så får du et rigtigt svar samme dag."
        : verdict.covered
          ? "Dækket af abonnementet. Trukket fra månedens supportminutter, ingen ekstraregning."
          : "Uden for abonnementet. Du får en pris, før der bliver rørt ved noget — ikke en regning bagefter.";

      const caveat = document.createElement("p");
      caveat.className = "try-caveat";
      caveat.textContent =
        "Skønnet her er lavet på nøgleord i din browser. Hos os læser vi beskeden ordentligt igennem.";

      verdictEl!.replaceChildren(p, caveat);

      stepsEl!.querySelectorAll<HTMLElement>(".step").forEach((li, i) => {
        if (reduce || i === 0) {
          li.classList.add("on");
          return;
        }
        timers.push(window.setTimeout(() => li.classList.add("on"), 420 + i * 620));
      });
    }

    const form = document.getElementById("demo-try") as HTMLFormElement | null;
    const input = document.getElementById("demo-input") as HTMLInputElement | null;
    form?.addEventListener("submit", (e) => {
      e.preventDefault();
      const message = input?.value.trim();
      if (!message) {
        input?.focus();
        return;
      }
      showOwn(message);
    });

    // Kør den første igennem, så optrapningen også ses ved sideindlæsning.
    show(0);
  }
</script>
